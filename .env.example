# Copy to .env.local. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional: narrates book descriptions. Add the key in Vercel, not in shared files.
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
# Optional: any ElevenLabs voice ID.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
